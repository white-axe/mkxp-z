# In Ruby 1.8, the superclass of a singleton class is a subclass of `Class`
# rather than the superclass of a singleton class being the class of the
# singleton class's object. For example, this code snippet prints `nil`,
# `false`, `true` and `false` in Ruby 1.8 but `true`, `true`, `nil` and `false`
# in Ruby versions later than 1.8.
#
#   class A; end
#   class << A.new
#     p self < A
#     p self.superclass == A
#     p self < Class
#     p self.superclass == Class
#   end

--- a/object.c
+++ b/object.c
@@ -934,6 +934,13 @@ rb_obj_is_kind_of(VALUE obj, VALUE c)
 static VALUE
 class_search_ancestor(VALUE cl, VALUE c)
 {
+    /* If syntax transform is active and targeting Ruby <= 1.8, change the superclass of singleton classes to be consistent with the Ruby 1.8 behavior when whether or not some class is a superclass of a singleton class is queried with the `<=` operator or similar ancestry-checking operators */
+    if (mkxp_ec_is_syntax_transform_active(1, 8, -1) && FL_TEST(cl, FL_SINGLETON)) {
+        if (cl == c || RCLASS_M_TBL(cl) == RCLASS_M_TBL(c))
+            return cl;
+        cl = RBASIC_CLASS(cl);
+    }
+
     while (cl) {
         if (cl == c || RCLASS_M_TBL(cl) == RCLASS_M_TBL(c))
             return cl;
@@ -1789,7 +1796,7 @@ rb_class_inherited_p(VALUE mod, VALUE arg)
 {
     if (mod == arg) return Qtrue;
 
-    if (RB_TYPE_P(arg, T_CLASS) && RB_TYPE_P(mod, T_CLASS)) {
+    if (!mkxp_ec_is_syntax_transform_active(1, 8, -1) && RB_TYPE_P(arg, T_CLASS) && RB_TYPE_P(mod, T_CLASS)) {
         // comparison between classes
         size_t mod_depth = RCLASS_SUPERCLASS_DEPTH(mod);
         size_t arg_depth = RCLASS_SUPERCLASS_DEPTH(arg);
@@ -2199,6 +2206,18 @@ rb_class_superclass(VALUE klass)
         rb_raise(rb_eTypeError, "uninitialized class");
     }
 
+    /* If syntax transform is active and targeting Ruby <= 1.8, change the superclass of singleton classes to be consistent with the Ruby 1.8 behavior when calling the `superclass` method of the singleton class */
+    if (mkxp_ec_is_syntax_transform_active(1, 8, -1) && FL_TEST(klass, FL_SINGLETON)) {
+        super = RBASIC_CLASS(klass);
+        while (RB_TYPE_P(super, T_ICLASS)) {
+            super = RCLASS_SUPER(super);
+        }
+        if (!super) {
+            return Qnil;
+        }
+        return super;
+    }
+
     if (!RCLASS_SUPERCLASS_DEPTH(klass)) {
         return Qnil;
     }
