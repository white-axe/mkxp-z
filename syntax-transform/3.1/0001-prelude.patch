# This patch adds a mechanism to selectively enable syntax transform in only
# some Ruby scripts.
#
# * When the Ruby functions `eval` or `instance_eval` are called while
#   `mkxp_syntax_transform_enabled_for_next_eval` is true,
#   `mkxp_syntax_transform_enabled_for_next_eval` is immediately set to false
#   and then `mkxp_parser_enable_syntax_transform()` is called on the parser
#   object used by that `eval` or `instance_eval` call to flag the parser as
#   having syntax transform enabled. The value of
#   `mkxp_syntax_transform_enabled_for_next_eval` can be changed from C/C++ to
#   specify which top-level `eval` calls need to have syntax transform enabled.
# * ASTs output by parsers on which `mkxp_parser_enable_syntax_transform()` has
#   been called have a flag set that indicates the AST has syntax transform
#   enabled.
# * Instruction sequences derived from ASTs that are flagged as having syntax
#   transform enabled are themselves flagged as having syntax transform enabled.
# * The syntax transform flag propagates to child instruction sequences of
#   instruction sequences.
# * When the Ruby functions `eval` or `instance_eval` are called from an
#   instruction sequence that has been flagged as having syntax transform
#   enabled, `mkxp_parser_enable_syntax_transform()` is called on the parser
#   object used by that `eval` or `instance_eval` call to flag the parser as
#   having syntax transform enabled. This ensures that the syntax transform flag
#   propagates into `eval` and `instance_eval` calls.
# * The other patches may add code that checks if the syntax transform flag is
#   set on the current parser or instruction sequence, depending on what part of
#   the codebase is being modified, in order to ensure that the syntax transform
#   is only enabled on the Ruby scripts where it should be enabled.

--- a/compile.c
+++ b/compile.c
@@ -44,6 +44,23 @@
 #include "insns.inc"
 #include "insns_info.inc"
 
+/**
+ * Check if mkxp syntax transform is active in the scope that `iseq` is in
+ * and is currently targeting a Ruby version that is less than or equal to
+ * the version given by `maximum_target_ruby_version_major` and
+ * `maximum_target_ruby_version_minor`
+ */
+static bool
+mkxp_is_syntax_transform_active(const rb_iseq_t *iseq, unsigned int maximum_target_ruby_version_major, unsigned int maximum_target_ruby_version_minor)
+{
+    extern unsigned int mkxp_syntax_transform_target_ruby_version_major, mkxp_syntax_transform_target_ruby_version_minor;
+    if (mkxp_syntax_transform_target_ruby_version_major > maximum_target_ruby_version_major || (mkxp_syntax_transform_target_ruby_version_major == maximum_target_ruby_version_major && mkxp_syntax_transform_target_ruby_version_minor > maximum_target_ruby_version_minor)) {
+        return FALSE;
+    }
+
+    return iseq->body->param.flags.mkxp_syntax_transform_flag;
+}
+
 #undef RUBY_UNTYPED_DATA_WARNING
 #define RUBY_UNTYPED_DATA_WARNING 0
 
--- a/iseq.c
