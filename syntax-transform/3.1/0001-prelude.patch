+/**
+ * Check if mkxp syntax transform is active in the current parser
+ * and is currently targeting a Ruby version that is less than or equal to
+ * the version given by `maximum_target_ruby_version_major` and
+ * `maximum_target_ruby_version_minor`
+ */
+static bool
+mkxp_is_syntax_transform_active(struct parser_params *p, unsigned int maximum_target_ruby_version_major, unsigned int maximum_target_ruby_version_minor)
+{
+    extern unsigned int mkxp_syntax_transform_target_ruby_version_major, mkxp_syntax_transform_target_ruby_version_minor;
+    if (mkxp_syntax_transform_target_ruby_version_major > maximum_target_ruby_version_major || (mkxp_syntax_transform_target_ruby_version_major == maximum_target_ruby_version_major && mkxp_syntax_transform_target_ruby_version_minor > maximum_target_ruby_version_minor)) {
+        return FALSE;
+    }
+
+    return p->mkxp_syntax_transform_flag;
+}
+
 #define intern_cstr(n,l,en) rb_intern3(n,l,en)
 
 #define STR_NEW(ptr,len) rb_enc_str_new((ptr),(len),p->enc)
@@ -8209,6 +8228,17 @@ parser_set_compile_option_flag(struct parser_params *p, const char *name, const
 		 RBOOL(b));
 }
 
+#ifndef RIPPER
+void
+mkxp_parser_enable_syntax_transform(VALUE vparser)
+{
+    struct parser_params *p;
+    TypedData_Get_Struct(vparser, struct parser_params, &parser_data_type, p);
+    p->mkxp_syntax_transform_flag = TRUE;
+    parser_set_compile_option_flag(p, "mkxp_syntax_transform_flag", "true");
+}
+#endif
