   vm_eval.c -
@@ -1704,6 +1714,19 @@ eval_make_iseq(VALUE src, VALUE fname, int line, const rb_binding_t *bind,
         fname = eval_default_path;
     }
 
+    /* If eval() or instance_eval() is called while mkxp_syntax_transform_enabled_for_next_eval is true, enable syntax transform for this call and immediately set mkxp_syntax_transform_enabled_for_next_eval to false */
+    if (mkxp_syntax_transform_enabled_for_next_eval) {
