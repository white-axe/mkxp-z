+
+    /* If code with syntax transform enabled calls eval() or instance_eval(), propagate the syntax transform into the eval() or instance_eval() call */
+    if (parent->body->param.flags.mkxp_syntax_transform_flag) {
+        void mkxp_parser_enable_syntax_transform(VALUE);
+        mkxp_parser_enable_syntax_transform(parser);
+    }
+
     rb_parser_set_context(parser, parent, FALSE);
     ast = rb_parser_compile_string_path(parser, fname, src, line);
     if (ast->body.root) {
