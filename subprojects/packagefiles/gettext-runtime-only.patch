# This patch makes it so that only gettext-runtime is built, and not libtextstyle or gettext-tools, in order to reduce the number of dependencies required for the build.

--- a/Makefile.in
+++ b/Makefile.in
@@ -323,7 +323,7 @@ top_builddir = @top_builddir@
 top_srcdir = @top_srcdir@
 AUTOMAKE_OPTIONS = 1.5 gnu
 ACLOCAL_AMFLAGS = -I m4
-SUBDIRS = gnulib-local gettext-runtime libtextstyle gettext-tools
+SUBDIRS = gnulib-local gettext-runtime
 changelog_etc = \
   gettext-runtime/ChangeLog.0 \
   gettext-runtime/doc/ChangeLog.0 \
--- a/configure
+++ b/configure
@@ -792,7 +792,7 @@ EMACS
 EMACSLOADPATH
 OBJC
 OBJCFLAGS'
-ac_subdirs_all='gettext-runtime libtextstyle gettext-tools'
+ac_subdirs_all='gettext-runtime'
 
 # Initialize some variables set by options.
 ac_init_help=
@@ -3020,7 +3020,7 @@ am__tar='{ find "$$tardir" -type d | LC_ALL=C sort; find "$$tardir" ! -type d -p
 
 
 
-subdirs="$subdirs gettext-runtime libtextstyle gettext-tools"
+subdirs="$subdirs gettext-runtime"
 
 
 
